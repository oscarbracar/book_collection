<h1>Users</h1>

<table>
  <thead>
    <tr>
      <th style="text-align: left;">Username</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td style="padding-right: 20px;"><%= user.username %></td>
        <td style="padding-right: 10px;"><%= link_to 'Show', user %></td>
        <td style="padding-right: 10px;"><%= link_to 'Edit', edit_user_path(user) %></td>
        <td><%= link_to 'Destroy', user, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "New User", new_user_path %>
